# Postgres connection string (Neon / Vercel Postgres / Supabase). REQUIRED on Vercel.
DATABASE_URL=postgres://user:pass@host/dbname?sslmode=require
# Random string, 32+ chars, used to sign login cookies. REQUIRED in production.
AUTH_SECRET=change-me-to-a-long-random-string-0123456789
# First admin account (created automatically on first request if no admin exists)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=choose-a-strong-password
